<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Banking API Automation Suite" verbose="1" parallel="false">

    <test name="Authentication Tests">
        <classes>
            <class name="com.banking.api.AuthTests"/>
        </classes>
    </test>

    <test name="Account Balance Tests">
        <classes>
            <class name="com.banking.api.AccountTests"/>
        </classes>
    </test>

    <test name="Fund Transfer Tests">
        <classes>
            <class name="com.banking.api.FundTransferTests"/>
        </classes>
    </test>

    <test name="Transaction History Tests">
        <classes>
            <class name="com.banking.api.TransactionTests"/>
        </classes>
    </test>

</suite>
