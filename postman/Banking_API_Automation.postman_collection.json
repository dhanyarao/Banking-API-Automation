{"info":{"name":"Banking API Automation","description":"Login, Balance, Fund Transfer, Transactions + boundary/edge/concurrent cases","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"00_Setup","item":[{"name":"Login - Valid Credentials","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/auth/login","host":["{{base_url}}"],"path":["api","v1","auth","login"]},"body":{"mode":"raw","raw":"{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","var j=pm.response.json();","pm.test('Token present',()=>{pm.expect(j.token).to.be.a('string').and.not.empty;});","if(pm.response.code===200)pm.environment.set('auth_token',j.token);"],"type":"text/javascript"}}]},{"name":"Login - Injection Username","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/auth/login","host":["{{base_url}}"],"path":["api","v1","auth","login"]},"body":{"mode":"raw","raw":"{\n  \"username\": \"' OR '1'='1\",\n  \"password\": \"x\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));","pm.test('No token',()=>pm.expect(pm.response.json().token).to.not.exist);"],"type":"text/javascript"}}]},{"name":"Login - Empty Body","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/auth/login","host":["{{base_url}}"],"path":["api","v1","auth","login"]},"body":{"mode":"raw","raw":"{}"}},"event":[{"listen":"test","script":{"exec":["pm.test('4xx not 500',()=>{pm.expect(pm.response.code).to.be.oneOf([400,401,422]);pm.expect(pm.response.code).to.not.eql(500);});"],"type":"text/javascript"}}]}]},{"name":"01_Accounts","item":[{"name":"Get Balance - Positive","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/accounts/{{account_id}}/balance","host":["{{base_url}}"],"path":["api","v1","accounts","{{account_id}}","balance"]}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('balance>=0',()=>{var j=pm.response.json();pm.expect(j.availableBalance).to.be.at.least(0);});"],"type":"text/javascript"}}]},{"name":"Get Balance - Invalid Token","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer invalidtoken"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/accounts/{{account_id}}/balance","host":["{{base_url}}"],"path":["api","v1","accounts","{{account_id}}","balance"]}},"event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));"],"type":"text/javascript"}}]},{"name":"Get Balance - Special Account ID","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/accounts/..%2F..%2Fetc/balance","host":["{{base_url}}"],"path":["api","v1","accounts","..%2F..%2Fetc","balance"]}},"event":[{"listen":"test","script":{"exec":["pm.test('safe status',()=>pm.expect(pm.response.code).to.be.oneOf([400,404,401]));","pm.test('no 500',()=>pm.expect(pm.response.code).to.not.eql(500));"],"type":"text/javascript"}}]}]},{"name":"02_Fund_Transfer","item":[{"name":"Successful Transfer","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/transfer","host":["{{base_url}}"],"path":["api","v1","transfer"]},"body":{"mode":"raw","raw":"{\n  \"fromAccount\": \"{{from_account}}\",\n  \"toAccount\": \"{{to_account}}\",\n  \"amount\": {{transfer_amount}},\n  \"currency\": \"INR\",\n  \"remarks\": \"ok\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('2xx',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));","pm.test('id',()=>{var j=pm.response.json();pm.expect(j.transactionId||j.referenceNumber).to.exist;});"],"type":"text/javascript"}}]},{"name":"Insufficient Funds","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/transfer","host":["{{base_url}}"],"path":["api","v1","transfer"]},"body":{"mode":"raw","raw":"{\n  \"fromAccount\": \"{{from_account}}\",\n  \"toAccount\": \"{{to_account}}\",\n  \"amount\": 99999999,\n  \"currency\": \"INR\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('400',()=>pm.response.to.have.status(400));","pm.test('msg',()=>pm.expect(pm.response.text().toLowerCase()).to.include('insufficient'));"],"type":"text/javascript"}}]},{"name":"Missing Fields","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/transfer","host":["{{base_url}}"],"path":["api","v1","transfer"]},"body":{"mode":"raw","raw":"{\n  \"fromAccount\": \"{{from_account}}\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('400',()=>pm.response.to.have.status(400));"],"type":"text/javascript"}}]},{"name":"Min Amount 0.01","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/transfer","host":["{{base_url}}"],"path":["api","v1","transfer"]},"body":{"mode":"raw","raw":"{\n  \"fromAccount\": \"{{from_account}}\",\n  \"toAccount\": \"{{to_account}}\",\n  \"amount\": 0.01,\n  \"currency\": \"INR\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('2xx',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));"],"type":"text/javascript"}}]},{"name":"Negative Amount","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/transfer","host":["{{base_url}}"],"path":["api","v1","transfer"]},"body":{"mode":"raw","raw":"{\n  \"fromAccount\": \"{{from_account}}\",\n  \"toAccount\": \"{{to_account}}\",\n  \"amount\": -100,\n  \"currency\": \"INR\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('4xx',()=>pm.expect(pm.response.code).to.be.oneOf([400,422]));"],"type":"text/javascript"}}]},{"name":"Zero Amount","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/transfer","host":["{{base_url}}"],"path":["api","v1","transfer"]},"body":{"mode":"raw","raw":"{\n  \"fromAccount\": \"{{from_account}}\",\n  \"toAccount\": \"{{to_account}}\",\n  \"amount\": 0,\n  \"currency\": \"INR\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('4xx',()=>pm.expect(pm.response.code).to.be.oneOf([400,422]));"],"type":"text/javascript"}}]},{"name":"Large Amount","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/transfer","host":["{{base_url}}"],"path":["api","v1","transfer"]},"body":{"mode":"raw","raw":"{\n  \"fromAccount\": \"{{from_account}}\",\n  \"toAccount\": \"{{to_account}}\",\n  \"amount\": 999999999999.99,\n  \"currency\": \"INR\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('400',()=>pm.response.to.have.status(400));","pm.test('no500',()=>pm.expect(pm.response.code).to.not.eql(500));"],"type":"text/javascript"}}]},{"name":"Special Chars Remarks","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/transfer","host":["