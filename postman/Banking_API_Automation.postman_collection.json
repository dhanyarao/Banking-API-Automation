{"info":{"name":"Banking API Automation","description":"Automated regression suite for Banking APIs - Login, Balance, Fund Transfer, Transactions. Created for practical learning.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"00_Setup","item":[{"name":"Login - Valid Credentials","event":[{"listen":"test","script":{"exec":["pm.test('Status code is 200', function () {","    pm.response.to.have.status(200);","});","","pm.test('Response time < 800ms', function () {","    pm.expect(pm.response.responseTime).to.be.below(800);","});","","pm.test('Token is present and is a string', function () {","    var json = pm.response.json();","    pm.expect(json).to.have.property('token');","    pm.expect(json.token).to.be.a('string').and.not.empty;","});","","if (pm.response.code === 200) {","    var json = pm.response.json();","    pm.environment.set('auth_token', json.token);","    console.log('auth_token saved to environment');","}"],"type":"text/javascript"}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"},"url":{"raw":"{{base_url}}/api/v1/auth/login","host":["{{base_url}}"],"path":["api","v1","auth","login"]}}},{"name":"Login - Injection Style Username (security edge)","event":[{"listen":"test","script":{"exec":["pm.test('Status code is 401', function () {","    pm.response.to.have.status(401);","});","","pm.test('No token returned', function () {","    var json = pm.response.json();","    pm.expect(json.token).to.not.exist;","});"],"type":"text/javascript"}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"' OR '1'='1\",\n  \"password\": \"anything\"\n}"},"url":{"raw":"{{base_url}}/api/v1/auth/login","host":["{{base_url}}"],"path":["api","v1","auth","login"]}}},{"name":"Login - Empty Body (edge)","event":[{"listen":"test","script":{"exec":["pm.test('Status is 400 or 401', function () {","    pm.expect(pm.response.code).to.be.oneOf([400, 401, 422]);","});","","pm.test('No 500', function () {","    pm.expect(pm.response.code).to.not.eql(500);","});"],"type":"text/javascript"}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{}"},"url":{"raw":"{{base_url}}/api/v1/auth/login","host":["{{base_url}}"],"path":["api","v1","auth","login"]}}}]},{"name":"01_Accounts","item":[{"name":"Get Balance - Positive","event":[{"listen":"test","script":{"exec":["pm.test('Status code is 200', function () {","    pm.response.to.have.status(200);","});","","pm.test('availableBalance is a number >= 0', function () {","    var json = pm.response.json();","    pm.expect(json.availableBalance).to.be.a('number');","    pm.expect(json.availableBalance).to.be.at.least(0);","});","","pm.test('currency is present', function () {","    pm.expect(pm.response.json()).to.have.property('currency');","});"],"type":"text/javascript"}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"}],"url":{"raw":"{{base_url}}/api/v1/accounts/{{account_id}}/balance","host":["{{base_url}}"],"path":["api","v1","accounts","{{account_id}}","balance"]}}},{"name":"Get Balance - Invalid Token","event":[{"listen":"test","script":{"exec":["pm.test('Status code is 401', function () {","    pm.response.to.have.status(401);","});","","pm.test('No balance data returned', function () {","    var json = pm.response.json();","    pm.expect(json).to.not.have.property('availableBalance');","});"],"type":"text/javascript"}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer invalidtoken12345"}],"url":{"raw":"{{base_url}}/api/v1/accounts/{{account_id}}/balance","host":["{{base_url}}"],"path":["api","v1","accounts","{{account_id}}","balance"]}}},{"name":"Get Balance - Special Account ID (edge)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/accounts/..%2F..%2Fetc/balance","host":["{{base_url}}"],"path":["api","v1","accounts","..%2F..%2Fetc","balance"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 400 or 404 (safe)', function () {","    pm.expect(pm.response.code).to.be.oneOf([400, 404, 401]);","});","","pm.test('No 500 / no stack trace leak', function () {","    pm.expect(pm.response.code).to.not.eql(500);","    var text = pm.response.text().toLowerCase();","    pm.expect(text).to.not.include('exception');","    pm.expect(text).to.not.include('stack');","});"],"type":"text/javascript"}}]}],"name":"02_Fund_Transfer","item":[]}]}
