{
  "info": {
    "name": "Banking API Automation",
    "description": "Automated regression suite for Banking APIs - Login, Balance, Fund Transfer, Transactions. Created for practical learning.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00_Setup",
      "item": [
        {
          "name": "Login - Valid Credentials",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status code is 200', function () {", "    pm.response.to.have.status(200);", "});", "", "pm.test('Response time < 800ms', function () {", "    pm.expect(pm.response.responseTime).to.be.below(800);", "});", "", "pm.test('Token is present and is a string', function () {", "    var json = pm.response.json();", "    pm.expect(json).to.have.property('token');", "    pm.expect(json.token).to.be.a('string').and.not.empty;", "});", "", "if (pm.response.code === 200) {", "    var json = pm.response.json();", "    pm.environment.set('auth_token', json.token);", "    console.log('auth_token saved to environment');", "}"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"},
            "url": {"raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"]}
          }
        }
      ]
    },
    {
      "name": "01_Accounts",
      "item": [
        {
          "name": "Get Balance - Positive",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status code is 200', function () {", "    pm.response.to.have.status(200);", "});", "", "pm.test('availableBalance is a number >= 0', function () {", "    var json = pm.response.json();", "    pm.expect(json.availableBalance).to.be.a('number');", "    pm.expect(json.availableBalance).to.be.at.least(0);", "});", "", "pm.test('currency is present', function () {", "    pm.expect(pm.response.json()).to.have.property('currency');", "});"], "type": "text/javascript"}}],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/accounts/{{account_id}}/balance", "host": ["{{base_url}}"], "path": ["api", "v1", "accounts", "{{account_id}}", "balance"]}
          }
        },
        {
          "name": "Get Balance - Invalid Token",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status code is 401', function () {", "    pm.response.to.have.status(401);", "});", "", "pm.test('No balance data returned', function () {", "    var json = pm.response.json();", "    pm.expect(json).to.not.have.property('availableBalance');", "});"], "type": "text/javascript"}}],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer invalidtoken12345"}],
            "url": {"raw": "{{base_url}}/api/v1/accounts/{{account_id}}/balance", "host": ["{{base_url}}"], "path": ["api", "v1", "accounts", "{{account_id}}", "balance"]}
          }
        }
      ]
    },
    {
      "name": "02_Fund_Transfer",
      "item": [
        {
          "name": "Successful Transfer",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status code is 200 or 201', function () {", "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);", "});", "", "pm.test('transactionId or referenceNumber is present', function () {", "    var json = pm.response.json();", "    pm.expect(json.transactionId || json.referenceNumber).to.exist;", "});", "", "pm.test('Status is SUCCESS', function () {", "    var json = pm.response.json();", "    if (json.status) {", "        pm.expect(json.status.toUpperCase()).to.eql('SUCCESS');", "    }", "});"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"fromAccount\": \"{{from_account}}\",\n  \"toAccount\": \"{{to_account}}\",\n  \"amount\": {{transfer_amount}},\n  \"currency\": \"INR\",\n  \"remarks\": \"Automated test transfer\"\n}"},
            "url": {"raw": "{{base_url}}/api/v1/transfer", "host": ["{{base_url}}"], "path": ["api", "v1", "transfer"]}
          }
        },
        {
          "name": "Insufficient Funds",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status code is 400', function () {", "    pm.response.to.have.status(400);", "});", "", "pm.test('Error message contains insufficient', function () {", "    var json = pm.response.json();", "    var msg = (json.message || json.error || JSON.stringify(json)).toLowerCase();", "    pm.expect(msg).to.include('insufficient');", "});", "", "pm.test('No transactionId returned', function () {", "    var json = pm.response.json();", "    pm.expect(json).to.not.have.property('transactionId');", "});"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"fromAccount\": \"{{from_account}}\",\n  \"toAccount\": \"{{to_account}}\",\n  \"amount\": 99999999.00,\n  \"currency\": \"INR\",\n  \"remarks\": \"Should fail - insufficient funds\"\n}"},
            "url": {"raw": "{{base_url}}/api/v1/transfer", "host": ["{{base_url}}"], "path": ["api", "v1", "transfer"]}
          }
        },
        {
          "name": "Missing Mandatory Fields",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status code is 400', function () {", "    pm.response.to.have.status(400);", "});", "", "pm.test('Validation error is returned', function () {", "    var json = pm.response.json();", "    pm.expect(json).to.satisfy(function (obj) {", "        return obj.message || obj.errors || obj.error;", "    });", "});"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"fromAccount\": \"{{from_account}}\"\n}"},
            "url": {"raw": "{{base_url}}/api/v1/transfer", "host": ["{{base_url}}"], "path": ["api", "v1", "transfer"]}
          }
        }
      ]
    },
    {
      "name": "03_Transactions",
      "item": [
        {
          "name": "Get Transaction History",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status code is 200', function () {", "    pm.response.to.have.status(200);", "});", "", "pm.test('Response is an array or contains data array', function () {", "    var json = pm.response.json();", "    var data = Array.isArray(json) ? json : (json.data || json.transactions || []);", "    pm.expect(data).to.be.an('array');", "});"], "type": "text/javascript"}}],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/transactions?accountId={{account_id}}&page=1&size=10", "host": ["{{base_url}}"], "path": ["api", "v1", "transactions"], "query": [{"key": "accountId", "value": "{{account_id}}"}, {"key": "page", "value": "1"}, {"key": "size", "value": "10"}]}
          }
        },
        {
          "name": "Get Transactions - Date Filter",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status code is 200', function () {", "    pm.response.to.have.status(200);", "});"], "type": "text/javascript"}}],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/transactions?accountId={{account_id}}&fromDate={{from_date}}&toDate={{to_date}}", "host": ["{{base_url}}"], "path": ["api", "v1", "transactions"], "query": [{"key": "accountId", "value": "{{account_id}}"}, {"key": "fromDate", "value": "{{from_date}}"}, {"key": "toDate", "value": "{{to_date}}"}]}
          }
        }
      ]
    }
  ],
  "variable": [{"key": "base_url", "value": "https://api.yourbank.com"}]
}
