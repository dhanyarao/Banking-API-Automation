cation/json"}],"url":{"raw":"{{base_url}}/api/v1/transactions?accountId={{account_id}}&page=1&size=10","host":["{{base_url}}"],"path":["api","v1","transactions"],"query":[{"key":"accountId","value":"{{account_id}}"},{"key":"page","value":"1"},{"key":"size","value":"10"}]}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"],"type":"text/javascript"}}]},{"name":"Date Filter","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/transactions?accountId={{account_id}}&fromDate={{from_date}}&toDate={{to_date}}","host":["{{base_url}}"],"path":["api","v1","transactions"],"query":[{"key":"accountId","value":"{{account_id}}"},{"key":"fromDate","value":"{{from_date}}"},{"key":"toDate","value":"{{to_date}}"}]}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"],"type":"text/javascript"}}]},{"name":"Invalid Date Range","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/v1/transactions?accountId={{account_id}}&fromDate=2026-08-01&toDate=2026-07-01","host":["{{base_url}}"],"path":["api","v1","transactions"],"query":[{"key":"accountId","value":"{{account_id}}"},{"key":"fromDate","value":"2026-08-01"},{"key":"toDate","value":"2026-07-01"}]}},"event":[{"listen":"test","script":{"exec":["pm.test('handled',()=>pm.expect(pm.response.code).to.be.oneOf([200,400,422]));","pm.test('no500',()=>pm.expect(pm.response.code).to.not.eql(500));"],"type":"text/javascript"}}]}]}],"variable":[{"key":"base_url","value":"https://api.yourbank.com"}]}
